def load_data():
    """Fetches queue data from the offline SQLite database."""
    try:
        conn = sqlite3.connect(DB_FILE)
        df = pd.read_sql_query("SELECT * FROM label_queue ORDER BY timestamp DESC", conn)
        conn.close()
        return df
    except sqlite3.OperationalError:
        return pd.DataFrame(columns=['id', 'business_reg_number', 'status', 'verdict', 'discrepancies', 'timestamp'])

# --- MAIN DASHBOARD ---
st.markdown("<h1>⚖️ TTB COLA Label Verification System</h1>", unsafe_allow_html=True)
st.markdown("<p class='big-font'>Automated Cross-Reference & Compliance Dashboard</p>", unsafe_allow_html=True)

# --- DIGITAL SUBMISSION PORTAL ---
with st.container():
    st.write("---")
    st.markdown("### 📤 Document Submission Portal")
    st.write("Select or drag-and-drop physical scans/digital files here. The system will automatically verify limits and route to the AI.")
    
    uploaded_files = st.file_uploader(
        "Supported formats: TIFF, JPEG, PNG (Max 1.5MB) | PDF, DOC/DOCX, TXT (Max 750KB)", 
        type=['png', 'jpg', 'jpeg', 'tif', 'tiff', 'pdf', 'doc', 'docx', 'txt'],
        accept_multiple_files=True
    )
    
    if st.button("📥 Submit Documents for Processing", use_container_width=True):
        if uploaded_files:
            for f in uploaded_files:
                size_kb = f.size / 1024
                is_image = f.name.lower().endswith(('.png', '.jpg', '.jpeg', '.tif', '.tiff'))
                
                # Strict file size validation
                if is_image and size_kb > 1536:
                    st.error(f"❌ Rejected: '{f.name}' ({size_kb/1024:.2f}MB) exceeds the 1.5MB image limit.")
                    continue
                elif not is_image and size_kb > 750:
                    st.error(f"❌ Rejected: '{f.name}' ({size_kb:.0f}KB) exceeds the 750KB document limit.")
                    continue
                
                # Route valid files to watchdog folder
                file_path = os.path.join(WATCH_FOLDER, f.name)
                with open(file_path, "wb") as out_file:
                    out_file.write(f.getbuffer())
                st.success(f"✅ Document accepted and routed to backend queue!")
        else:
            st.warning("Please select a file to upload first.")

st.write("---")

