tab1, tab2 = st.tabs(["📋 Complete Master Queue", "🚨 Action Required: Flagged Applications"])

def render_queue(dataframe, empty_message):
    if dataframe.empty:
        st.info(empty_message)
    else:
        for index, row in dataframe.iterrows():
            
            # Color coding logic
            if row['status'] == 'Processing':
                icon = "⏳"
                color = "#D35400" # Orange
            elif row['verdict'] == 'COMPLIANT':
                icon = "✅"
                color = "#006400" # Green
            elif row['verdict'] == 'COMPLIANT-DOC':
                icon = "📎"
                color = "#555555" # Grey for supporting docs
            else:
                icon = "❌"
                color = "#B22222" # Red
                
            # ANONYMITY: Display Business Reg Number (BRN) instead of filename/company name
            header_text = f"{icon} App #{row['id']} | Business Reg: {row.get('business_reg_number', 'UNKNOWN')} | Status: {row['status']}"
            
            with st.expander(header_text):
                if row['status'] == 'Processing':
                    st.warning("The AI is currently cross-referencing this submission. Please wait...", icon="⏳")
                else:
                    st.markdown(f"<p style='color:{color}; font-size:24px; font-weight:bold;'>Verdict: {row['verdict']}</p>", unsafe_allow_html=True)
                    st.markdown("**Compliance Report:**")
                    st.write(row['discrepancies'])

with tab1:
    render_queue(df, "The master queue is currently empty. Use the portal above to submit files.")

with tab2:
    # Filter ONLY non-compliant apps for agents to quickly address
    flagged_df = df[df['verdict'] == 'NON-COMPLIANT']
    render_queue(flagged_df, "Excellent! There are currently no flagged applications requiring review.")
